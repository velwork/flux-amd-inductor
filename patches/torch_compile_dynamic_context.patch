+class _SelectiveDynamicModule(torch.nn.Module):
+    """Mark only requested input axes dynamic before entering Inductor."""
+
+    def __init__(self, module: torch.nn.Module, compile_kwargs: dict,
+                 dynamic_input_dims: dict[str, tuple[int, int | None, int | None]]):
+        super().__init__()
+        self.compiled_module = torch.compile(model=module, **compile_kwargs)
+        parameters = list(inspect.signature(module.forward).parameters)
+        self.dynamic_inputs = []
+        for name, (dim, minimum, maximum) in dynamic_input_dims.items():
+            position = parameters.index(name) if name in parameters else None
+            self.dynamic_inputs.append((name, position, dim, minimum, maximum))
+
+    def __getattr__(self, name):
+        """Preserve the wrapped diffusion model's public attributes for ComfyUI."""
+        try:
+            return super().__getattr__(name)
+        except AttributeError:
+            compiled_module = super().__getattr__("compiled_module")
+            return getattr(compiled_module, name)
+
+    def forward(self, *args, **kwargs):
+        for name, position, dim, minimum, maximum in self.dynamic_inputs:
+            value = kwargs.get(name)
+            if value is None and position is not None and position < len(args):
+                value = args[position]
+            if torch.is_tensor(value):
+                torch._dynamo.mark_dynamic(
+                    value, dim, min=minimum, max=maximum
+                )
+        return self.compiled_module(*args, **kwargs)
+
